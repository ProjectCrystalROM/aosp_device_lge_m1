# CM13 fs_mgr format: block-device mount-point filesystem mount-flags fs_mgr-flags
# Evidence: stockimages/recovery.bin recovery fstab, stock boot fstab.m1 and GPT.
# Named bootdevice paths are used by the stock cmdline/ueventd configuration.
/dev/block/bootdevice/by-name/boot      /boot      emmc  defaults defaults
/dev/block/bootdevice/by-name/recovery  /recovery  emmc  defaults defaults
/dev/block/bootdevice/by-name/misc      /misc      emmc  defaults defaults
/dev/block/bootdevice/by-name/system    /system    ext4  defaults wait
/dev/block/bootdevice/by-name/cache     /cache     ext4  defaults wait
/dev/block/bootdevice/by-name/userdata  /data      ext4  defaults wait,encryptable=/dev/block/bootdevice/by-name/encrypt
